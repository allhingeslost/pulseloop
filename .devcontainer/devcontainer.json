{
  "name": "DevBox",
  "image": "ghcr.io/allhingeslost/devbox:latest",

  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/host-sync/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.config/gh,target=/tmp/host-sync/gh,type=bind,readonly",
    "source=${localEnv:HOME}/.config/opencode,target=/tmp/host-sync/opencode,type=bind,readonly",
    "source=${localEnv:HOME}/.local/share/opencode,target=/tmp/host-sync/opencode-share,type=bind,readonly"
  ],

  "postStartCommand": "bash .devcontainer/sync-config.sh"
}
