{
  "name": "PulseLoop DevBox",
  "image": "ghcr.io/allhingeslost/devbox:latest",
  "privileged": true,
  "remoteUser": "vscode",

  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/setup/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.config/gh,target=/tmp/setup/gh,type=bind,readonly",
    "source=${localEnv:HOME}/.config/opencode,target=/tmp/setup/opencode-config,type=bind,readonly",
    "source=${localEnv:HOME}/.local/share/opencode,target=/tmp/setup/opencode-share,type=bind,readonly"
  ],

  "postStartCommand": "bash .devcontainer/setup.sh"
}